# Copy this file to .env for running on your own computer.
# On Vercel, enter the same names under Project -> Settings -> Environment Variables.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vehicle_rental_db

# Cloud MySQL (Aiven / Railway): set DB_SSL=true
DB_SSL=false
# Optional: CA certificate text from your MySQL provider (strict SSL check)
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Database clock: Indian time so CURDATE() matches the website
DB_TIMEZONE=+05:30

# Save every query in api_query_log (needs database/06_query_log.sql)
LOG_QUERIES=true

PORT=3000
